# Proxy reverso de produção — termina HTTPS (Let's Encrypt automático via
# Caddy) em mentis.renatomota.online e roteia para os containers internos.
# Pré-requisito: o DNS de mentis.renatomota.online precisa apontar para o IP
# desta VPS, com as portas 80 e 443 liberadas (Caddy usa a 80 para o desafio
# ACME HTTP-01 antes de emitir o certificado).
mentis.renatomota.online {
	handle /v1/* {
		reverse_proxy api:3001
	}

	handle /docs* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
