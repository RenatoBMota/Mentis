# --- Banco de dados ---
DATABASE_URL="postgresql://psiflow:psiflow@localhost:5432/psiflow?schema=public"

# --- Redis (filas / cache) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Criptografia de campo (PRD 11.1 — prontuário em repouso) ---
# Chave AES-256 em base64 (32 bytes). Gerar com: openssl rand -base64 32
# Em produção, mover para um cofre de segredos dedicado, nunca versionar o valor real.
ENCRYPTION_KEY="change-me-32-bytes-base64-000000="

# --- WhatsApp Gateway (Evolution API / Z-API) ---
WHATSAPP_PROVIDER="evolution-api"
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# --- App ---
API_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
