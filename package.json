{
  "name": "psiflow",
  "version": "0.1.0",
  "private": true,
  "description": "PsiFlow — Sistema Clínico de Gestão para Psicólogos",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @psiflow/api dev",
    "dev:web": "pnpm --filter @psiflow/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @psiflow/api prisma generate",
    "db:migrate": "pnpm --filter @psiflow/api prisma migrate dev",
    "prepare": "husky || true"
  }
}
